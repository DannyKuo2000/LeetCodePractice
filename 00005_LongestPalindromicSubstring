class Solution:
    def longestPalindrome(self, s: str) -> str:
        max = 0
        for i in range(0, len(s) * 2):
            length = 0
            # initialize head and tail
            if i % 2 == 0: #中心點在字上 
                head = i - 2
                tail = i + 2
            else: # 中心點在字中間
                head = i - 1
                tail = i + 1 


            while head >= 0 and tail <= len(s) * 2 - 1:
                if s[int(head / 2)] != s[int(tail / 2)]:
                    break
                else:
                    head = head - 2
                    tail = tail + 2

            length = (tail - head - 2) / 2
            if length > max:
                max = length
                label1 = head + 2
                label2 = tail - 2

        return s[int(label1 / 2) : int(label2 / 2) + 1]


