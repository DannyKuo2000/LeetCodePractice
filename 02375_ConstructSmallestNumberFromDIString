class Solution:
    def smallestNumber(self, pattern: str) -> str:
        '''
        Main method:
        counting how many D in each region devided by I:
        '''
        record = []
        counter = 0
        for i in range(0, len(pattern)):
            if (pattern[i] == 'I'):
                record.append(counter)
                counter = 0
            else: # pattern == 'D'
                counter += 1
        record.append(counter)

        output_list = []
        counter = 0
        max_used = 0
        

        
        for i in range(0, len(record)):
            # processing I and first letter
            max_used = max_used + record[i] + 1
            output_list.append(str(max_used))

            # processing D
            label = max_used - 1
            for j in range(0, record[i]):
                output_list.append(str(label))
                label -= 1
        return "".join(output_list)
            
            

        

            


                







