class Solution:
    def reverse(self, x: int) -> int:
        rev = 0
        remain = abs(x)
        while remain != 0:
            print(remain)
            print(rev)
            temp = remain % 10
            remain = (remain - temp) / 10
            if rev != 0:
                rev = rev * 10
            rev = rev + temp

        if x > 0:
            rev = int(rev)
        else:
            rev = int(-rev)
        print(rev)
        
        if -2^31 > rev or 2^31 - 1 < rev:
            rev = 0
        print(rev)
        return rev

