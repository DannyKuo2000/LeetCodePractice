class Solution:
    def isPalindrome(self, x: int) -> bool:
        if x < 0:
            return False
        elif x == 0:
            return True
        else:
            x_str = str(x)
            head = 0
            tail = len(x_str) - 1
            while head < tail:
                if x_str[head] != x_str[tail]:
                    return False
                else:
                    head += 1
                    tail -= 1
            return True
                    