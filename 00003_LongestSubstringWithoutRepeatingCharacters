class Solution:
    def lengthOfLongestSubstring(self, s: str) -> int:
        maximum = 0
        counter = 0
        head = 0
        tail = 0
        while tail < len(s) :
            print(maximum, counter, head, tail)
            for i in range(head, tail): # check repetition
                if s[tail] == s[i]:
                    head = i + 1
            counter = tail - head + 1
            if counter > maximum:
                maximum = counter 
            tail = tail + 1
        return maximum